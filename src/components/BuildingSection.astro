---
---
<section class="building-section" id="building" aria-labelledby="building-title">
  <span id="currently-building" class="building-section__anchor" aria-hidden="true"></span>
  <picture class="building-section__media" aria-hidden="true">
    <img src="/images/pg27-road-panorama.png" alt="" width="2172" height="724" loading="lazy" decoding="async" />
  </picture>
  <div class="building-section__scrim" aria-hidden="true"></div>

  <div class="container building-section__inner">
    <div class="building-section__copy">
      <p class="eyebrow">CURRENTLY BUILDING</p>
      <h2 id="building-title">PG27</h2>
      <p class="building-section__subheading">Building transaction infrastructure.</p>
      <p class="building-section__description">An API/AI-first system designed to coordinate sales processing, payment orchestration, document workflows and fiscalization through a registry-driven platform and independently deployed execution nodes.</p>
      <a class="building-section__link" href="/journal">Follow the progress <span aria-hidden="true">→</span></a>
    </div>
  </div>

  <div class="building-panel" aria-label="PG27 development status">
    <div class="building-counter" role="group" aria-label="PG27 development counter">
      <div class="building-counter__metric">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M8 3v4M16 3v4M4 11h16" />
          <path d="M6 5h12a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z" />
          <path d="M8 15h2v2H8zM14 15h2v2h-2z" />
        </svg>
        <span class="building-counter__value">
          <strong data-counter-days aria-live="polite">183</strong>
          <span>days</span>
        </span>
      </div>

      <details class="building-counter__estimate">
        <summary aria-label="About the estimated engineering hours">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 3" />
          </svg>
          <span class="building-counter__value">
            <strong>~<span data-counter-hours aria-live="polite">2,400</span></strong>
            <span>hrs</span>
          </span>
        </summary>
        <p class="building-counter__explanation">Estimated engineering hours since May 1, 2026.</p>
      </details>

      <p class="building-counter__as-of" data-counter-as-of>As of 30 Oct 2026 · Europe/Moscow</p>
    </div>

    <dl class="building-status">
      <div class="building-status__item">
        <dt>Focus</dt>
        <dd>Document workflows</dd>
      </div>
      <div class="building-status__item">
        <dt>Stage</dt>
        <dd>Advanced development</dd>
      </div>
      <div class="building-status__item building-status__item--goal">
        <dt>Goal</dt>
        <dd>End-to-end transaction lifecycle</dd>
      </div>
    </dl>
  </div>
</section>

<script>
  import { getDevelopmentCounter, millisecondsUntilNextProjectDay, PROJECT_TIME_ZONE } from '../scripts/building-counter.js';

  const counterSection = document.querySelector('.building-section');
  const daysValue = counterSection?.querySelector('[data-counter-days]');
  const hoursValue = counterSection?.querySelector('[data-counter-hours]');
  const asOfValue = counterSection?.querySelector('[data-counter-as-of]');

  if (daysValue && hoursValue && asOfValue) {
    const updateCounter = () => {
      const counter = getDevelopmentCounter();
      daysValue.textContent = String(counter.days);
      hoursValue.textContent = new Intl.NumberFormat('en-US').format(counter.estimatedHours);
      asOfValue.textContent = `As of ${counter.dateLabel} · ${PROJECT_TIME_ZONE}`;
    };

    const scheduleNextProjectDay = () => {
      window.setTimeout(() => {
        updateCounter();
        scheduleNextProjectDay();
      }, millisecondsUntilNextProjectDay());
    };

    updateCounter();
    scheduleNextProjectDay();
  }
</script>
