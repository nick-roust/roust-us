---
---
<section class="building-section" id="building" aria-labelledby="building-title">
  <span id="currently-building" class="building-section__anchor" aria-hidden="true"></span>
  <picture class="building-section__media" aria-hidden="true">
    <img src="/images/pg27-road-panorama.png" alt="" width="2172" height="724" loading="lazy" decoding="async" />
  </picture>
  <div class="building-section__scrim" aria-hidden="true"></div>

  <div class="container building-section__inner">
    <div class="building-section__copy">
      <p class="eyebrow">CURRENTLY BUILDING</p>
      <h2 id="building-title">PG27</h2>
      <p class="building-section__subheading">Building transaction infrastructure.</p>
      <p class="building-section__description">An API/AI-first system designed to coordinate sales processing, payment orchestration, document workflows and fiscalization through a registry-driven platform and independently deployed execution nodes.</p>
      <div class="building-counter" role="group" aria-label="PG27 development counter">
        <div class="building-counter__line">
          <span class="building-counter__metric">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M8 2v4M16 2v4M3 10h18" />
              <path d="M5 4h14a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" />
              <path d="M7 14h2m3 0h2m3 0h1M7 17h2m3 0h2" />
            </svg>
            <strong data-counter-days>183</strong><span>days</span>
          </span>
          <span class="building-counter__separator" aria-hidden="true">·</span>
          <details class="building-counter__estimate">
            <summary aria-label="Estimated engineering hours. Open explanation." aria-describedby="engineering-hours-tooltip" aria-controls="engineering-hours-tooltip" aria-expanded="false">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 3" /></svg>
              <strong data-counter-hours>2,400</strong><span>hrs</span>
            </summary>
          </details>
        </div>
        <p id="engineering-hours-tooltip" class="building-counter__explanation" role="tooltip" hidden>Estimated engineering hours since May 1, 2026.</p>
        <noscript><p class="building-counter__explanation building-counter__explanation--fallback">Estimated engineering hours since May 1, 2026.</p></noscript>
        <p class="building-counter__as-of" data-counter-as-of>As of 30 Oct 2026</p>
      </div>
      <a class="building-section__link" href="/journal">Follow the progress <span aria-hidden="true">→</span></a>
    </div>
  </div>

  <div class="building-panel" aria-label="PG27 development status">
    <dl class="building-status">
      <div class="building-status__item">
        <dt>Focus</dt>
        <dd>Document workflows</dd>
      </div>
      <div class="building-status__item">
        <dt>Stage</dt>
        <dd>Advanced development</dd>
      </div>
      <div class="building-status__item building-status__item--goal">
        <dt>Goal</dt>
        <dd>End-to-end transaction lifecycle</dd>
      </div>
    </dl>
  </div>
</section>

<script>
  import { getDevelopmentCounter, millisecondsUntilNextProjectDay } from '../scripts/building-counter.js';

  const counterSection = document.querySelector('.building-section');
  const daysValue = counterSection?.querySelector('[data-counter-days]');
  const hoursValue = counterSection?.querySelector('[data-counter-hours]');
  const asOfValue = counterSection?.querySelector('[data-counter-as-of]');

  if (daysValue && hoursValue && asOfValue) {
    const updateCounter = () => {
      const counter = getDevelopmentCounter();
      daysValue.textContent = String(counter.days);
      hoursValue.textContent = new Intl.NumberFormat('en-US').format(counter.estimatedHours);
      asOfValue.textContent = `As of ${counter.dateLabel}`;
    };

    const scheduleNextProjectDay = () => {
      window.setTimeout(() => {
        updateCounter();
        scheduleNextProjectDay();
      }, millisecondsUntilNextProjectDay());
    };

    updateCounter();
    scheduleNextProjectDay();
  }

  const hoursDisclosure = counterSection?.querySelector('.building-counter__estimate') as HTMLDetailsElement | null;
  const hoursTrigger = hoursDisclosure?.querySelector('summary') as HTMLElement | null;
  const hoursTooltip = counterSection?.querySelector('#engineering-hours-tooltip') as HTMLElement | null;

  if (hoursDisclosure && hoursTrigger && hoursTooltip) {
    let pinned = false;
    let hovering = false;
    let focused = false;
    let dismissed = false;
    let touchActivation = false;
    const hoverEnabled = window.matchMedia('(hover: hover) and (pointer: fine)');

    const updateTooltip = () => {
      const open = !dismissed && (pinned || hovering || focused);
      hoursDisclosure.open = open;
      hoursTooltip.hidden = !open;
      hoursTrigger.setAttribute('aria-expanded', String(open));
    };

    hoursDisclosure.addEventListener('pointerenter', (event: PointerEvent) => {
      if (hoverEnabled.matches && event.pointerType === 'mouse') {
        hovering = true;
        dismissed = false;
        updateTooltip();
      }
    });
    hoursDisclosure.addEventListener('pointerleave', (event: PointerEvent) => {
      if (event.pointerType === 'mouse') {
        hovering = false;
        if (!pinned && !focused) dismissed = false;
        updateTooltip();
      }
    });
    hoursTrigger.addEventListener('pointerdown', (event: PointerEvent) => {
      if (event.pointerType === 'touch') {
        touchActivation = true;
        hovering = false;
        focused = false;
      }
    });
    hoursTrigger.addEventListener('click', event => {
      event.preventDefault();
      const open = touchActivation ? !pinned : !hoursDisclosure.open;
      if (touchActivation) focused = false;
      touchActivation = false;
      pinned = open;
      dismissed = !open;
      updateTooltip();
    });
    hoursTrigger.addEventListener('focus', () => {
      if (touchActivation) return;
      focused = true;
      dismissed = false;
      updateTooltip();
    });
    hoursTrigger.addEventListener('blur', () => {
      focused = false;
      if (!pinned && !hovering) dismissed = false;
      updateTooltip();
    });
    document.addEventListener('pointerdown', (event: PointerEvent) => {
      if (event.target instanceof Node && !hoursDisclosure.contains(event.target)) {
        touchActivation = false;
        pinned = false;
        hovering = false;
        focused = false;
        dismissed = true;
        updateTooltip();
      }
    });
    document.addEventListener('keydown', (event: KeyboardEvent) => {
      if (event.key === 'Escape' && hoursDisclosure.open) {
        event.preventDefault();
        pinned = false;
        hovering = false;
        focused = false;
        dismissed = true;
        updateTooltip();
      }
    });
  }
</script>
