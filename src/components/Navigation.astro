---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isProduct = ['/labs/fake-bank', '/labs/fake-shop', '/building-paymentgate', '/projects/paymentgate', '/bik', '/projects/pg27', '/labs/bik-ed807'].includes(path);
const links = [
  { href: '/about', label: 'About', current: path === '/about' },
  { href: '/#building', label: 'Building', current: false },
  { href: '/#systems', label: 'Projects', current: isProduct },
  { href: '/journal/', label: 'Journal', current: path === '/journal' || path.startsWith('/journal/') },
  { href: '#contact', label: 'Contact', current: false },
];
---
<nav class="primary-nav" aria-label="Main navigation">
  {links.map(({ href, label, current }) => (
    <a href={href} aria-current={current ? 'page' : undefined}>{label}</a>
  ))}
</nav>
