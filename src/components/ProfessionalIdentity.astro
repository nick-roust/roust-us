---
import SocialProfiles from './SocialProfiles.astro';
---
<section class="contact-section" id="contact" aria-labelledby="contact-title">
  <div class="container contact-section__layout">
    <div class="contact-section__copy">
      <p class="eyebrow">Contact</p>
      <h2 id="contact-title">Let's build something.</h2>
      <p class="contact-section__invite">Open for collaboration, consulting and new projects.</p>
    </div>
    <div class="contact-section__channels">
        <SocialProfiles />
    </div>
  </div>
</section>
