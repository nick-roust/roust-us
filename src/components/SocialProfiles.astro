---
const platforms = ['GitHub', 'LinkedIn', 'Facebook', 'VK', 'Telegram'];
---
<ul class="profile-list" aria-label="Profile links pending verification">
  {platforms.map((platform) => (
    <li class="profile-list__item">
      <span class="profile-list__icon" aria-hidden="true">
        {platform === 'GitHub' && (
          <svg viewBox="0 0 24 24" focusable="false"><path d="M12 .8a11.2 11.2 0 0 0-3.54 21.83c.56.1.76-.24.76-.54v-2.1c-3.1.68-3.75-1.31-3.75-1.31-.5-1.28-1.24-1.62-1.24-1.62-1.01-.69.08-.68.08-.68 1.12.08 1.71 1.16 1.71 1.16 1 .1 1.56-1.01 1.56-1.01.5-.87 1.29-1.1 1.29-1.1-2.48-.28-5.09-1.24-5.09-5.53 0-1.22.44-2.22 1.16-3-.12-.29-.5-1.42.11-2.96 0 0 .95-.3 3.08 1.15a10.7 10.7 0 0 1 5.6 0c2.13-1.45 3.08-1.15 3.08-1.15.61 1.54.23 2.67.11 2.96.72.78 1.16 1.78 1.16 3 0 4.3-2.61 5.24-5.1 5.52.4.35.75 1.03.75 2.08v3.09c0 .3.2.65.77.54A11.2 11.2 0 0 0 12 .8Z" /></svg>
        )}
        {platform === 'LinkedIn' && (
          <svg viewBox="0 0 24 24" focusable="false"><path d="M5.3 3.3a2.2 2.2 0 1 1 0 4.4 2.2 2.2 0 0 1 0-4.4ZM3.5 9h3.6v11.5H3.5V9Zm5.8 0h3.4v1.6h.1a3.7 3.7 0 0 1 3.3-1.8c3.5 0 4.2 2.3 4.2 5.2v6.5h-3.6v-5.8c0-1.4 0-3.1-1.9-3.1s-2.1 1.5-2.1 3v5.9H9.3V9Z" /></svg>
        )}
        {platform === 'Facebook' && (
          <svg viewBox="0 0 24 24" focusable="false"><path d="M13.8 21v-8.2h2.8l.4-3.2h-3.2V7.5c0-.9.3-1.5 1.6-1.5h1.7V3.1c-.3 0-1.4-.1-2.6-.1-2.6 0-4.3 1.6-4.3 4.4v2.2H7.3v3.2h2.9V21h3.6Z" /></svg>
        )}
        {platform === 'VK' && (
          <svg viewBox="0 0 24 24" focusable="false"><path d="M3.2 7.2h3.1c.2 3.3 1.5 4.7 2.5 5V7.2h2.9v2.9c1-.1 2.1-1.4 2.5-2.9h2.9a6.6 6.6 0 0 1-2.4 4c1.1.5 2.2 1.8 2.9 4.1h-3.2c-.5-1.4-1.5-2.5-2.7-2.6v2.6h-.4c-4.7 0-7.4-3.2-7.5-8.1Z" /></svg>
        )}
        {platform === 'Telegram' && (
          <svg viewBox="0 0 24 24" focusable="false"><path d="m21.6 4.2-3.3 15.5c-.2 1.1-.8 1.4-1.7.9l-4.8-3.5-2.3 2.2c-.3.3-.5.5-1 .5l.4-4.9 8.9-8c.4-.4-.1-.6-.6-.2L6.2 13.6l-4.7-1.5c-1-.3-1-1 .2-1.5L20 3.7c.9-.3 1.8.2 1.6.5Z" /></svg>
        )}
      </span>
      <span class="profile-list__name">{platform}</span>
      <span class="profile-list__status">Link pending verification</span>
    </li>
  ))}
</ul>
