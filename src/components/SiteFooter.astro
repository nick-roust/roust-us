---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p>© 2006-{currentYear} ROUST.US</p>
    <a class="site-footer__brand" href="/" aria-label="ROUST.US home">
      <img src="/brand/roust-monogram-color.svg" alt="" width="48" height="48" />
    </a>
    <a class="site-footer__top" href="#main">Back to top <span aria-hidden="true">↑</span></a>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid rgba(255, 255, 255, .2); background: #101b26; color: rgba(255,255,255,.82); }
  .site-footer__inner { min-height: 6.25rem; display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 1rem; font-size: .82rem; }
  .site-footer__inner p { margin: 0; }
  .site-footer__inner a { color: inherit; text-decoration: none; }
  .site-footer__brand { display: block; width: 48px; height: 48px; justify-self: center; }
  .site-footer__brand img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .site-footer__top { justify-self: end; }
  @media (max-width: 680px) {
    .site-footer__inner { min-height: 5rem; font-size: .72rem; }
    .site-footer__brand { width: 40px; height: 40px; }
  }
</style>
