---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getVisibleJournalEntries } from '../../lib/journal';

export async function getStaticPaths() {
  const entries = await getCollection('journal');
  return getVisibleJournalEntries(entries, import.meta.env.DEV)
    .map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const dateLabel = entry.data.displayDate;
const heroImage = entry.data.hero;
---

<SiteLayout title={entry.data.title} description={entry.data.summary} showPageTitle={false}>
  <article class="journal-entry">
    <header class={heroImage ? 'journal-entry__hero' : 'journal-entry__editorial'}>
      {heroImage && (
        <img class="journal-entry__hero-image" src={heroImage.src} alt={heroImage.alt} width="1600" height="1067" fetchpriority="high" />
      )}
      {heroImage && <div class="journal-entry__hero-scrim" aria-hidden="true"></div>}
      <div class:list={['container', heroImage ? 'journal-entry__hero-inner' : 'journal-entry__editorial-inner']}>
        <a class="journal-entry__back" href="/journal"><span aria-hidden="true">←</span> Engineering Chronicle</a>
        <p class="eyebrow">{entry.data.type} <span aria-hidden="true">·</span> {entry.data.project}</p>
        <h1>{entry.data.title}</h1>
        <p class="journal-entry__date">{dateLabel}</p>
      </div>
    </header>

    <div class="journal-entry__body container">
      <div class="journal-entry__prose"><Content /></div>
      <nav class="journal-entry__footer" aria-label="Journal navigation">
        <a class="text-link" href="/journal"><span aria-hidden="true">←</span> Back to Engineering Chronicle</a>
      </nav>
    </div>
  </article>
</SiteLayout>

<style>
  .journal-entry__editorial { color: var(--ink); }
  .journal-entry__editorial-inner { padding-top: var(--section-block-spacing); }
  .journal-entry__editorial .journal-entry__back { margin-bottom: 1.5rem; color: var(--muted); }
  .journal-entry__editorial .journal-entry__back:hover { color: var(--ink); }
  .journal-entry__editorial .journal-entry__back span { color: var(--accent-strong); }
  .journal-entry__editorial .eyebrow { margin-bottom: 1.15rem; color: var(--accent-strong); font-weight: 650; }
  .journal-entry__editorial h1 { max-width: 19ch; margin: 0 0 .75rem; font-size: clamp(2.65rem, 5vw, 4.25rem); font-weight: 570; letter-spacing: -.06em; line-height: 1.03; }
  .journal-entry__editorial .journal-entry__date { color: var(--muted); }
  @media (max-width: 680px) {
    .journal-entry__editorial h1 { font-size: clamp(2.7rem, 12vw, 3.8rem); }
  }
</style>
