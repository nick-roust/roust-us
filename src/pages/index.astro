---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="I build systems." description="Fintech, software architecture, and AI-assisted engineering." isHome={true} showPageTitle={false}>
  <div class="home-page">
    <section class="hero" aria-labelledby="hero-title">
      <picture class="hero__media" aria-hidden="true">
        <source media="(max-width: 680px)" type="image/avif" srcset="/images/hero-mountains-mobile-390.avif 390w, /images/hero-mountains-mobile-530.avif 530w" sizes="100vw" />
        <source media="(max-width: 680px)" type="image/webp" srcset="/images/hero-mountains-mobile-390.webp 390w, /images/hero-mountains-mobile-530.webp 530w" sizes="100vw" />
        <source type="image/avif" srcset="/images/hero-mountains-desktop-960.avif 960w, /images/hero-mountains-desktop-1938.avif 1938w" sizes="100vw" />
        <source type="image/webp" srcset="/images/hero-mountains-desktop-960.webp 960w, /images/hero-mountains-desktop-1938.webp 1938w" sizes="100vw" />
        <img class="hero__image" src="/images/hero-mountains-desktop-1938.webp" srcset="/images/hero-mountains-desktop-960.webp 960w, /images/hero-mountains-desktop-1938.webp 1938w" sizes="100vw" width="1938" height="812" alt="" fetchpriority="high" decoding="async" />
      </picture>
      <div class="container hero__inner">
        <div class="hero__copy">
          <h1 id="hero-title">I build systems.</h1>
          <p class="hero__author">Nick &quot;Nickolaich&quot; Roust</p>
          <p class="hero__descriptor">Fintech · Software Architecture · AI-Assisted Engineering</p>
          <p class="hero__statement">I design, build and operate systems<br />that work in the real world.</p>
          <a class="text-link hero__link" href="#currently-building"><span aria-hidden="true">↓</span>Explore</a>
        </div>
      </div>
    </section>

    <section class="systems-section section-wrap" id="currently-building" aria-labelledby="currently-building-title">
      <div class="container">
        <p class="section-index"><span>Currently Building</span></p>
        <div class="feature-project">
          <div class="feature-project__copy">
            <p class="eyebrow">Long-term project</p>
            <h2 id="currently-building-title">PaymentGate</h2>
            <p>Public project information is being prepared from confirmed material.</p>
            <span class="status-label"><span aria-hidden="true"></span>Work in progress</span>
            <a class="button-link" href="/building-paymentgate">Building PaymentGate <span aria-hidden="true">→</span></a>
          </div>
          <div class="feature-project__visual" aria-hidden="true">
            <span class="feature-project__number">CURRENTLY BUILDING</span>
            <img src="/brand/roust-monogram-color.svg" alt="" width="168" height="168" loading="lazy" />
            <span class="feature-project__caption">PaymentGate</span>
          </div>
        </div>
      </div>
    </section>

    <section class="open-source-section section-wrap" aria-labelledby="open-source-title">
      <div class="container journal-section__grid">
        <p class="section-index"><span>Open Source</span></p>
        <div>
          <p class="eyebrow">Independent tools</p>
          <h2 id="open-source-title">Built to be explored.</h2>
          <p>Open-source projects and their verified public repositories.</p>
          <ul class="open-source-list">
            <li><a href="https://github.com/nick-roust/fake-bank" target="_blank" rel="noopener noreferrer">Fake-bank <span>Apache 2.0 · payment provider simulator ↗</span></a></li>
            <li><a href="https://github.com/nick-roust/fake-shop" target="_blank" rel="noopener noreferrer">fake-shop <span>Apache 2.0 · reference commerce application ↗</span></a></li>
          </ul>
          <a class="text-link" href="/open-source">Explore open source <span aria-hidden="true">→</span></a>
        </div>
        <div class="journal-section__mark" aria-hidden="true"><span>OPEN SOURCE</span><span>02</span></div>
      </div>
    </section>

    <section class="journal-section section-wrap" aria-labelledby="journal-title">
      <div class="container journal-section__grid">
        <p class="section-index"><span>Journal</span></p>
        <div>
          <p class="eyebrow">Engineering Chronicle</p>
          <h2 id="journal-title">Work, as it happens.</h2>
          <p>A record of milestones, engineering notes, visual stories, publications and retrospectives.</p>
          <a class="text-link" href="/journal">Visit the chronicle <span aria-hidden="true">→</span></a>
        </div>
        <div class="journal-section__mark" aria-hidden="true"><span>CHRONICLE</span><span>01</span></div>
      </div>
    </section>
  </div>
</SiteLayout>
