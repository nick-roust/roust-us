---
import Navigation from '../components/Navigation.astro';
import ThemeControl from '../components/ThemeControl.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  isHome?: boolean;
  showPageTitle?: boolean;
}

const { title, description, isHome = false, showPageTitle = true } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101b26" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <title>{title} · ROUST.US</title>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let mode = 'system';
        try {
          mode = localStorage.getItem('roust-theme') || 'system';
        } catch {}
        if (!['system', 'light', 'dark'].includes(mode)) mode = 'system';
        root.dataset.theme = mode;
        root.classList.add('js');
      })();
    </script>
  </head>
  <body class:list={[isHome && 'home-shell']}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href="/" aria-label="ROUST.US home">
          <img class="brand__wordmark" src="/brand/roust-name-white.svg" alt="" width="180" height="24" />
        </a>
        <Navigation />
        <div class="header-actions">
          <a class="header-github" href="https://github.com/nick-roust" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.1c-3.14.68-3.8-1.33-3.8-1.33-.51-1.3-1.25-1.64-1.25-1.64-1.03-.7.08-.69.08-.69 1.14.08 1.74 1.17 1.74 1.17 1.01 1.73 2.66 1.23 3.31.94.1-.73.4-1.23.72-1.51-2.51-.29-5.15-1.26-5.15-5.6 0-1.24.44-2.25 1.17-3.04-.12-.29-.51-1.45.11-3.02 0 0 .95-.3 3.1 1.16a10.8 10.8 0 0 1 5.64 0c2.15-1.46 3.1-1.16 3.1-1.16.62 1.57.23 2.73.11 3.02.73.79 1.17 1.8 1.17 3.04 0 4.35-2.65 5.3-5.17 5.59.41.36.77 1.05.77 2.12v3.15c0 .3.2.65.78.54A11.25 11.25 0 0 0 12 .75Z" />
            </svg>
          </a>
          <ThemeControl />
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1" class:list={['site-main', isHome && 'site-main--home']}>
      {showPageTitle && <h1 class="page-title container">{title}</h1>}
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <a class="footer-brand" href="/">ROUST.US</a>
        <p>Independent engineering projects and notes.</p>
        <a href="#main">Back to top <span aria-hidden="true">↑</span></a>
      </div>
    </footer>

    <script>
      const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const themeRoot = document.documentElement;
      const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');

      function activeTheme() {
        const selected = themeRoot.dataset.theme;
        return selected === 'light' || selected === 'dark' ? selected : systemTheme.matches ? 'dark' : 'light';
      }

      function updateThemeControl() {
        const nextTheme = activeTheme() === 'dark' ? 'light' : 'dark';
        themeToggle?.setAttribute('aria-label', `Switch to ${nextTheme} theme`);
      }

      updateThemeControl();
      systemTheme.addEventListener('change', () => {
        if (themeRoot.dataset.theme === 'system') updateThemeControl();
      });
      themeToggle?.addEventListener('click', () => {
        const nextTheme = activeTheme() === 'dark' ? 'light' : 'dark';
        themeRoot.dataset.theme = nextTheme;
        try {
          localStorage.setItem('roust-theme', nextTheme);
        } catch {}
        updateThemeControl();
      });
    </script>
  </body>
</html>
